{
	"name": "codicillus",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Codicillus — base de connaissances documentaire. Squelette applicatif (lot T-002).",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && eslint . && prettier --check .",
		"test:unit": "vitest run",
		"base:migrer": "node base/base.mjs migrer",
		"base:annuler": "node base/base.mjs annuler",
		"base:etat": "node base/base.mjs etat",
		"base:semer": "node base/base.mjs semer",
		"base:reindexer": "node base/base.mjs reindexer",
		"base:administrateur": "node base/base.mjs administrateur"
	},
	"dependencies": {
		"@node-rs/argon2": "2.1.0",
		"@tiptap/core": "3.30.1",
		"@tiptap/extension-character-count": "3.30.1",
		"@tiptap/extension-image": "3.30.1",
		"@tiptap/extension-link": "3.30.1",
		"@tiptap/extension-placeholder": "3.30.1",
		"@tiptap/extension-table": "3.30.1",
		"@tiptap/extension-task-item": "3.30.1",
		"@tiptap/extension-task-list": "3.30.1",
		"@tiptap/pm": "3.30.1",
		"@tiptap/starter-kit": "3.30.1",
		"d3-force": "3.0.0",
		"d3-hierarchy": "3.1.2",
		"diff": "9.0.0",
		"dompurify": "3.4.13",
		"drizzle-orm": "0.45.2",
		"graphology": "0.26.0",
		"graphology-communities-louvain": "2.0.2",
		"graphology-metrics": "2.4.0",
		"highlight.js": "11.12.0",
		"lowlight": "3.3.0",
		"meilisearch": "0.60.0",
		"mermaid": "11.16.1",
		"pg": "8.23.0",
		"prosemirror-model": "1.25.11",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "^24.13.3",
		"@types/pg": "8.23.1",
		"eslint": "10.8.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.9",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	}
