{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [],
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(npx playwright *)",
      "Bash(sha256sum *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
