# ─────────────────────────────────────────────────────────────────────────────
# Codicillus — variables de la composition d'exploitation (lot T-003).
#
# Copier ce fichier en `.env` À CÔTÉ de `compose.yaml`, puis remplir. `.env` est
# ignoré par git : AUCUN SECRET N'ENTRE DANS LE DÉPÔT, et aucune valeur par
# défaut n'est fournie pour un mot de passe ou une clé. Les deux secrets sont
# déclarés `${…:?}` dans `compose.yaml` : la composition REFUSE de démarrer
# tant qu'ils manquent, plutôt que de démarrer avec une valeur devinable.
#
#     cp .env.example .env
#     # puis, pour chacun des deux secrets :
#     openssl rand -hex 32
#
# Chaque variable est documentée ci-dessous, sans exception.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identité de la composition ───────────────────────────────────────────────

# Nom du projet Docker Compose : préfixe des conteneurs, des volumes et du
# réseau. À changer pour faire coexister deux compositions sur la même machine
# (une copie de travail agentique, par exemple).
# Obligatoire : non — défaut `codicillus`.
NOM_PROJET=codicillus

# ── Adressage public et TLS ──────────────────────────────────────────────────

# Adresse publique du site, telle que le frontal doit l'entendre. Elle décide à
# elle seule du TLS, qui est automatique dans les trois cas :
#   https://codicillus.exemple.fr  → certificat public, émis par ACME. Le
#                                    domaine doit pointer sur la machine et les
#                                    ports 80 et 443 doivent lui parvenir.
#   https://codicillus.localhost   → certificat de l'autorité interne de Caddy,
#                                    pour une machine de développement.
#   http://localhost               → aucun TLS. À réserver au diagnostic.
# Cette valeur sert aussi d'ORIGIN à l'application : elle doit être l'origine
# EXACTE vue par le navigateur, schéma compris.
# Obligatoire : OUI — la composition refuse de démarrer sans elle.
ADRESSE_SITE=https://codicillus.exemple.fr

# Adresse de courriel transmise à l'autorité de certification pour les avis
# d'expiration. Inutile avec l'autorité interne : laisser vide. Laissée vide,
# la directive n'est pas posée du tout dans la configuration du frontal — un
# `email` sans argument y serait une erreur de syntaxe.
# Obligatoire : non — défaut vide.
COURRIEL_ACME=

# ── Secrets ──────────────────────────────────────────────────────────────────
# Les deux lignes qui suivent sont VOLONTAIREMENT VIDES dans cet exemple.

# Mot de passe du compte PostgreSQL de l'application. Il n'est lu qu'à la
# première initialisation du volume `db_donnees` : le changer ensuite exige un
# `ALTER ROLE`, pas seulement une modification de ce fichier.
# AUCUNE CONTRAINTE DE FORME. Ce mot de passe n'entre dans aucune URI : ARB-038
# a supprimé `URL_BASE` du contrat de déploiement, et `src/lib/base/connexion.ts`
# passe au connecteur un OBJET — rien n'est concaténé, donc rien n'est à
# échapper (ARB-050). Un `/`, un `#` ou un `?` y sont désormais inoffensifs.
# La recommandation hexadécimale ci-dessous n'est qu'une commodité.
# Obligatoire : OUI. Engendrer avec `openssl rand -hex 32`.
MDP_POSTGRES=

# Clé maître de Meilisearch. Meilisearch en mode `production` refuse de démarrer
# sans clé d'au moins 16 octets. La perdre n'est pas grave : l'index est
# reconstructible (RG-NF-09), et une nouvelle clé se pose en réinitialisant le
# volume `recherche_donnees` puis en réindexant.
# Obligatoire : OUI. Engendrer avec `openssl rand -hex 32`.
CLE_MAITRE_RECHERCHE=

# ── PostgreSQL ───────────────────────────────────────────────────────────────

# Compte propriétaire de la base. Lu à la première initialisation du volume.
# Obligatoire : non — défaut `codicillus`.
UTILISATEUR_POSTGRES=codicillus

# Nom de la base de vérité — contenu, versions, droits, configuration, journaux,
# vecteurs de sens, et la file de tâches `pg-boss` (C-13 : pas de Redis).
# Obligatoire : non — défaut `codicillus`.
BASE_POSTGRES=codicillus

# ── Briques optionnelles ─────────────────────────────────────────────────────
# Ces réglages ne conditionnent JAMAIS le démarrage du produit (P-10, ADR-009).

# Modèle d'embeddings servi par Ollama. Volontairement VIDE : le choix du modèle
# est un paramètre à trancher par mesure sur le corpus réel, pas a priori
# (STACK §10 R-04 et §11 point 4). Le renseigner ne suffit pas à l'installer —
# `docker compose exec embeddings ollama pull <modèle>` le tire dans le volume.
# Obligatoire : non — défaut vide, mode « Sens » indisponible et signalé.
MODELE_EMBEDDINGS=

# Délai maximal, en secondes, accordé à la conversion d'un fichier. Une pièce
# malformée doit échouer vite et seule, sans emporter le lot (RG-M12-04).
# Obligatoire : non — défaut 120.
DELAI_MAX_CONVERSION=120

# ── Ports de l'hôte ──────────────────────────────────────────────────────────
# Seuls PORT_HTTP et PORT_HTTPS sont ouverts sur l'extérieur. Les quatre autres
# sont publiés sur la boucle locale (127.0.0.1) : ils servent l'exploitation —
# `pg_dump`, inspection de l'index, mesure — et ne sont pas joignables du
# réseau. Les valeurs ci-dessous sont celles employées par le lot T-003 ;
# décaler tout le bloc suffit à faire coexister deux compositions.

# Frontal, HTTP. Doit être 80 en production : ACME valide le domaine par ce port.
PORT_HTTP=19080

# Frontal, HTTPS. Doit être 443 en production.
PORT_HTTPS=19443

# Application, en accès direct — diagnostic seulement, le public passe par le
# frontal. Boucle locale.
PORT_APP=19300

# PostgreSQL. Boucle locale. C'est par ce port que passe `pg_dump` (RG-NF-09).
PORT_DB=19432

# Meilisearch. Boucle locale.
PORT_RECHERCHE=19700

# Service de conversion. Boucle locale.
PORT_CONVERSION=19800

# Ollama. Boucle locale.
PORT_EMBEDDINGS=19114
