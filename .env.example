# Copier ce fichier en .env. Les valeurs de cet exemple ouvrent http://localhost:19080.
NOM_PROJET=codicillus
VERSION_CODICILLUS=1.0.0-rc.1

# Adresse écoutée par Caddy, sans les ports publiés sur l'hôte.
ADRESSE_SITE=http://localhost
# Adresse exacte saisie dans le navigateur, port compris s'il n'est pas standard.
ORIGINE_PUBLIQUE=http://localhost:19080

# HTTPS sans Internet : "tls internal", ou certificat fourni (voir docs/installation.md).
# Vide : TLS public automatique pour une adresse HTTPS ; aucun TLS pour HTTP.
DIRECTIVE_TLS=
COURRIEL_ACME=
# true isole les services internes d'Internet. Le frontal conserve son réseau d'accès.
RESEAU_INTERNE=false

# Secrets requis. Générer deux valeurs différentes (voir docs/installation.md).
# Utiliser des guillemets simples si une valeur contient $, #, un espace ou un antislash.
MDP_POSTGRES=
CLE_MAITRE_RECHERCHE=
UTILISATEUR_POSTGRES=codicillus
BASE_POSTGRES=codicillus

# Premier compte uniquement : retirer ces quatre valeurs après sa création.
ADMIN_IDENTIFIANT=
ADMIN_NOM=
ADMIN_COURRIEL=
MDP_ADMINISTRATEUR=

# Exécution locale avec pnpm ; Docker utilise son volume nommé fichiers.
RACINE_FICHIERS=./.local/fichiers
# Local uniquement ; Docker fournit l'adresse interne du service de conversion.
URL_CONVERSION=http://127.0.0.1:19800
DELAI_MAX_CONVERSION=120

# En production avec les ports standards : PORT_HTTP=80 et PORT_HTTPS=443.
PORT_HTTP=19080
PORT_HTTPS=19443
# Accès de diagnostic limités à la boucle locale.
PORT_APP=19300
PORT_DB=19432
PORT_RECHERCHE=19700
PORT_CONVERSION=19800
